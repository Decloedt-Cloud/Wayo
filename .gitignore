#--------------------------------------------------------------------
# Environment / secrets
#--------------------------------------------------------------------
.env
.env.*
!.env.example
socketio-server/.env

#--------------------------------------------------------------------
# Dependencies
#--------------------------------------------------------------------
/vendor/
/composer.lock
/node_modules/
socketio-server/node_modules/

#--------------------------------------------------------------------
# CI4 writable (runtime)
#--------------------------------------------------------------------
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
!writable/debugbar/index.html

#--------------------------------------------------------------------
# Legacy CI3 paths (kept for safety)
#--------------------------------------------------------------------
application/config/database.php
application/config/config.php
application/cache/*
application/logs/*

