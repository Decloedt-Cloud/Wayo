RewriteEngine On

# Force masked app URLs through CI4 front controller.
# Without this, "/app" can be treated as the physical directory and return 404.
RewriteRule ^app/?$ index.php/app [L,QSA]
RewriteRule ^app/(.*)$ index.php/app/$1 [L,QSA]

# Route all requests to CI4 index.php
# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]

# Empêcher l'indexation des répertoires
Options -Indexes

# Blocage complet du répertoire vendor
RewriteRule ^vendor(/|$) - [F,L]
RewriteRule ^writable(/|$) - [F,L]
RewriteRule ^\.env$ - [F,L]

