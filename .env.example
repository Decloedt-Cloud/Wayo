#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production
CI_DEBUG = 0

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://your-domain.tld/'
app.forceGlobalSecureRequests = true
# app.proxyIPs = '127.0.0.1'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = wayo_db
database.default.username = your_db_user
database.default.password = your_db_password
database.default.DBDriver = MySQLi

#--------------------------------------------------------------------
# SECURITY / ENCRYPTION
#--------------------------------------------------------------------
# Generate with: php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)), PHP_EOL;"
encryption.key = hex2bin:CHANGE_ME_32_BYTE_HEX
jwt.secret = CHANGE_ME_LONG_RANDOM_STRING
cron.token = CHANGE_ME_LONG_RANDOM_HEX

#--------------------------------------------------------------------
# BIGBLUEBUTTON / SOCKETS
#--------------------------------------------------------------------
bbb.url = https://your-bbb-host/bigbluebutton/api/
bbb.urlPlay = https://your-bbb-host
bbb.urlOld = https://your-bbb-host:80/
bbb.secret = CHANGE_ME
bbb.hookToken = CHANGE_ME
bbb.socketEmitUrl = https://your-domain.tld/emit
bbb.socketEmitKey = CHANGE_ME
bbb.appBaseUrl = https://your-domain.tld

#--------------------------------------------------------------------
# AI
#--------------------------------------------------------------------
ai.deepseekUrl = https://api.deepseek.com/v1/chat/completions
ai.deepseekApiKey = CHANGE_ME
ai.localLlmUrl =
